{
  "compilerOptions": {
    "baseUrl": "src",
    "rootDir": "src",
    "outDir": "dist",
    "allowImportingTsExtensions": false,
    "allowSyntheticDefaultImports": true,
    "noEmit": false,
    "declaration": true,
    "esModuleInterop": true,
    "jsx": "react-jsx", // This is for vscode not to suggest importing React, after react17.
    "lib": ["ESNext"],
    "skipLibCheck": true,
    "types": ["jest"],
    // RN 0.88 dropped its top-level "types" field and only exposes types via package.json "exports",
    // which Node10 resolution ignores. Point at the Strict TypeScript API types directly. Switching to
    // "moduleResolution": "bundler" would make this unnecessary, but it requires ESM output for dist/.
    "paths": {
      "react-native": ["../node_modules/react-native/types_generated/index.d.ts"]
    }
  },
  "include": ["src/**/*"]
}
